{
  "name": "fireroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 0.0.0.0",
    "dev:https": "vite --configLoader native --host 0.0.0.0 --mode https",
    "build": "tsc --noEmit && vite build --configLoader native",
    "test": "vitest run --configLoader native",
    "relay": "node scripts/relay.mjs",
    "test:private": "vitest run --configLoader native --config vitest.private.config.ts",
    "gateway": "node scripts/dev-gateway.ts",
    "diagnostics": "node scripts/phone-vega-diagnostics.mjs",
    "vega:prepare": "node scripts/prepare-vega.mjs",
    "release:check": "node scripts/check-public-release.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "qrcode": "^1.5.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.6.0"
  },
  "license": "MIT"
}
